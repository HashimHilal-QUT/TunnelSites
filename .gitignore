# --- Dependencies ---
node_modules/
.pnpm-store/
.yarn/
package-lock.json (optional: keep if you rely on strict lockfile commits)

# --- Environment & Credentials ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# --- Docker & Local Volume Mounts ---
