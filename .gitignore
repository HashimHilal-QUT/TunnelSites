.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Build Outputs & Caches ---
dist/
build/
.next/
.out/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Latency & Testing Artifacts ---
*.summary.json
*.csv